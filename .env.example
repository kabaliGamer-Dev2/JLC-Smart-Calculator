# ==========================================
# ⚙️ Java LLM Smart Calculator (JLC) Config
# Author: KABALI GAMER
# ==========================================

# Choose LLM Provider: 'GROQ', 'LOCAL' (Ollama), or 'CLOUD' (OpenAI)
LLM_MODE=GROQ

# --- Option A: Groq API (Recommended for ultra-fast <300ms inference) ---
GROQ_API_KEY=your_groq_api_key_here
MODEL_NAME=openai/gpt-oss-120b

# --- Option B: Local Ollama (100% Offline & Free) ---
OLLAMA_HOST=http://localhost:11434

# --- Option C: OpenAI Cloud API ---
OPENAI_API_KEY=your_openai_api_key_here
